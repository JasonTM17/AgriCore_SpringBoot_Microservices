{
  "name": "@agricore/console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "contracts:generate": "openapi-typescript ../../contracts/openapi/identity-service.v1.yaml -o src/lib/api/generated/identity.ts",
    "contracts:check": "pnpm contracts:generate && git ls-files --error-unmatch src/lib/api/generated/identity.ts && git diff --exit-code -- src/lib/api/generated/identity.ts",
    "build": "tsc -b --pretty false && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "catalog:",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-plugin": "catalog:",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "eslint": "10.7.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.7.0",
    "jsdom": "29.1.1",
    "openapi-typescript": "catalog:",
    "tailwindcss": "4.3.3",
    "typescript": "catalog:",
    "typescript-eslint": "8.64.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
