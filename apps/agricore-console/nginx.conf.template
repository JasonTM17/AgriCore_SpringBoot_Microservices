server {
    # nginx-unprivileged image; non-root cannot bind :80
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # M3: baseline security headers for SPA edge (compose + Helm share this template).
    # CSP matches Vite-built same-origin assets; connect-src 'self' covers /api proxy.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none';" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "DENY" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    # GATEWAY_UPSTREAM is envsubst'd at container start:
    # Compose default: api-gateway:8080
    # Helm default: agricore-gateway:8080
    # Nginx vars use $$ so envsubst leaves a single $ for nginx.
    location /api/ {
        proxy_pass http://${GATEWAY_UPSTREAM}/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $$host;
        proxy_set_header X-Real-IP $$remote_addr;
        proxy_set_header X-Forwarded-For $$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $$scheme;
        proxy_buffering off;
        proxy_read_timeout 3600s;
    }

    location /public/api/ {
        proxy_pass http://${GATEWAY_UPSTREAM}/public/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $$host;
        proxy_set_header X-Forwarded-For $$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $$scheme;
    }

    location / {
        try_files $$uri $$uri/ /index.html;
    }
}
