server {
    # nginx-unprivileged image; non-root cannot bind :80
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # GATEWAY_UPSTREAM is envsubst'd at container start:
    # Compose default: api-gateway:8080
    # Helm default: agricore-gateway:8080
    # Nginx vars use $$ so envsubst leaves a single $ for nginx.
    location /api/ {
        proxy_pass http://${GATEWAY_UPSTREAM}/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $$host;
        proxy_set_header X-Real-IP $$remote_addr;
        proxy_set_header X-Forwarded-For $$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $$scheme;
        proxy_buffering off;
        proxy_read_timeout 3600s;
    }

    location /public/api/ {
        proxy_pass http://${GATEWAY_UPSTREAM}/public/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $$host;
        proxy_set_header X-Forwarded-For $$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $$scheme;
    }

    location / {
        try_files $$uri $$uri/ /index.html;
    }
}
