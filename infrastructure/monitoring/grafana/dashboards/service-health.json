{
  "annotations": {"list": []},
  "editable": false,
  "panels": [
    {"type": "stat", "title": "Availability", "id": 1, "gridPos": {"h": 6, "w": 8, "x": 0, "y": 0}, "targets": [{"expr": "avg_over_time(up{job=~\"$service\"}[15m])", "legendFormat": "{{job}}"}], "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []}},
    {"type": "timeseries", "title": "JVM heap used", "id": 2, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6}, "targets": [{"expr": "sum by (job) (jvm_memory_used_bytes{job=~\"$service\",area=\"heap\"})", "legendFormat": "{{job}}"}], "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []}},
    {"type": "timeseries", "title": "Live JVM threads", "id": 3, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 6}, "targets": [{"expr": "jvm_threads_live_threads{job=~\"$service\"}", "legendFormat": "{{job}}"}]}
  ],
  "refresh": "15s",
  "schemaVersion": 39,
  "tags": ["agricore", "services"],
  "templating": {"list": [{"name": "service", "label": "Service", "type": "query", "datasource": {"type": "prometheus", "uid": "prometheus"}, "query": {"query": "label_values(up, job)", "refId": "service"}, "includeAll": true, "multi": true, "current": {"text": "All", "value": "$__all"}}]},
  "time": {"from": "now-6h", "to": "now"},
  "timezone": "browser",
  "title": "AgriCore Service Health",
  "uid": "agricore-service-health",
  "version": 1
