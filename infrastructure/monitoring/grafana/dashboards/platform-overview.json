    {"type": "stat", "title": "Services up", "id": 1, "gridPos": {"h": 6, "w": 6, "x": 0, "y": 0}, "targets": [{"expr": "sum(up{job=~\"$service\"})", "legendFormat": "up"}]},
    {"type": "stat", "title": "5xx rate", "id": 2, "gridPos": {"h": 6, "w": 6, "x": 6, "y": 0}, "targets": [{"expr": "sum(rate(http_server_requests_seconds_count{job=~\"$service\",status=~\"5..\"}[5m]))", "legendFormat": "errors/s"}]},
    {"type": "timeseries", "title": "Request throughput", "id": 3, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6}, "targets": [{"expr": "sum by (job) (rate(http_server_requests_seconds_count{job=~\"$service\"}[5m]))", "legendFormat": "{{job}}"}]},
