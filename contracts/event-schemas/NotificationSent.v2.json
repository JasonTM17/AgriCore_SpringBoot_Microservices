{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agricore.local/schemas/NotificationSent.v2.json",
  "title": "NotificationSent.v2",
  "allOf": [
    { "$ref": "DomainEventEnvelope.v1.json" },
    {
      "type": "object",
      "properties": {
        "eventType": { "const": "NotificationSent.v2" },
        "eventVersion": { "const": 2 },
        "producer": { "const": "notification-service" },
        "payload": {
          "type": "object",
          "required": ["notificationId", "sourceEventId", "sourceEventType", "channel", "recipient", "subject", "correlationId", "status", "deliveryAttempts", "sentAt"],
          "properties": {
            "notificationId": { "type": "string", "format": "uuid" },
            "sourceEventId": { "type": ["string", "null"], "format": "uuid" },
            "sourceEventType": { "type": "string", "minLength": 1 },
            "channel": { "type": "string", "minLength": 1, "maxLength": 32 },
            "recipient": { "type": "string", "minLength": 1, "maxLength": 320 },
            "subject": { "type": "string", "minLength": 1, "maxLength": 300 },
            "correlationId": { "type": ["string", "null"], "maxLength": 100 },
            "status": { "const": "SENT" },
            "deliveryAttempts": { "type": "integer", "minimum": 1, "maximum": 5 },
            "sentAt": { "type": "string", "format": "date-time" }
          },
          "additionalProperties": false
        }
      }
    }
  ]
}
