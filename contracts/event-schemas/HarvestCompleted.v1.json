{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agricore.local/schemas/HarvestCompleted.v1.json",
  "title": "HarvestCompleted.v1",
  "allOf": [
    { "$ref": "DomainEventEnvelope.v1.json" },
    {
      "type": "object",
      "properties": {
        "eventType": { "const": "HarvestCompleted.v1" },
        "eventVersion": { "const": 1 },
        "producer": { "const": "harvest-service" },
        "payload": {
          "type": "object",
          "required": [
            "harvestId",
            "harvestBatchId",
            "farmId",
            "cropCycleId",
            "plotId",
            "warehouseId",
            "productCode",
            "grossWeightKg",
            "netWeightKg",
            "qualityGrade",
            "harvestDate",
            "productName"
          ],
          "properties": {
            "harvestId": { "type": "string", "format": "uuid" },
            "harvestBatchId": { "type": "string", "format": "uuid" },
            "farmId": { "type": "string", "format": "uuid" },
            "cropCycleId": { "type": "string", "format": "uuid" },
            "plotId": { "type": "string", "format": "uuid" },
            "warehouseId": { "type": "string", "format": "uuid" },
            "productCode": { "type": "string", "minLength": 1, "maxLength": 64 },
            "grossWeightKg": { "type": "number", "minimum": 0.001 },
            "netWeightKg": { "type": "number", "minimum": 0.001 },
            "qualityGrade": { "type": "string", "minLength": 1, "maxLength": 32 },
            "harvestDate": { "type": "string", "format": "date" },
            "farmName": { "type": "string", "minLength": 1, "maxLength": 200 },
            "plotCode": { "type": "string", "minLength": 1, "maxLength": 64 },
            "productName": { "type": "string", "minLength": 1, "maxLength": 200 },
            "careSummary": { "type": "string", "minLength": 1, "maxLength": 1000 }
          },
          "additionalProperties": false
        }
      }
    }
  ]
}
