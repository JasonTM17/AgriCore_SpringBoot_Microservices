{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agricore.local/schemas/PlotCreated.v1.json",
  "title": "PlotCreated.v1",
  "allOf": [
    { "$ref": "DomainEventEnvelope.v1.json" },
    {
      "type": "object",
      "properties": {
        "eventType": { "const": "PlotCreated.v1" },
        "eventVersion": { "const": 1 },
        "producer": { "const": "farm-service" },
        "payload": {
          "type": "object",
          "required": ["plotId", "farmId", "code", "name", "status", "areaInHectares"],
          "properties": {
            "plotId": { "type": "string", "format": "uuid" },
            "farmId": { "type": "string", "format": "uuid" },
            "code": { "type": "string", "minLength": 1, "maxLength": 64 },
            "name": { "type": "string", "minLength": 1, "maxLength": 200 },
            "status": { "const": "AVAILABLE" },
            "areaInHectares": { "type": "number", "minimum": 0.0001 }
          },
          "additionalProperties": false
        }
      }
    }
  ]
}
