# AgriCore local development — copy to .env (never commit .env)

# --- Postgres (shared host, separate DBs) ---
POSTGRES_USER=agricore
POSTGRES_PASSWORD=agricore_dev_change_me
POSTGRES_HOST=localhost
POSTGRES_PORT=5434

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6380

# --- MQTT (local development credentials; replace outside local Compose) ---
MQTT_SERVICE_USERNAME=agricore_iot
MQTT_SERVICE_PASSWORD=agricore_iot_dev_change_me
MQTT_DEVICE_PASSWORD_SEED=agricore_device_seed_dev_change_me
# Optional comma-separated device codes; empty generates codes from count/prefix.
MQTT_DEVICE_USERS=
MQTT_BIND=127.0.0.1
MQTT_PORT=1883
MQTT_DEVICE_COUNT=1
MQTT_ITERATIONS=1
MQTT_INTERVAL_SECONDS=5
MQTT_PLOT_MAP=DEMO-SOIL-001=PLOT-DEMO-001
MQTT_MIN_VALUE=30
MQTT_MAX_VALUE=70
MQTT_ANOMALY_PROBABILITY_PERCENT=20
MQTT_SEED=42
# Optional fixed ISO-8601 timestamp for byte-for-byte deterministic payloads.
MQTT_RECORDED_AT=

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- Internal service authentication (local only; rotate via secret manager elsewhere) ---
INVENTORY_INTERNAL_SERVICE_TOKEN=agricore_inventory_internal_dev_change_me_32_chars

# --- Object storage (local MinIO; use a secret manager outside local development) ---
MINIO_BIND=127.0.0.1
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=agricore_minio
MINIO_ROOT_PASSWORD=agricore_minio_dev_change_me
OBJECT_STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
WORK_ATTACHMENT_BUCKET=agricore-work-attachments
OBJECT_STORAGE_DOWNLOAD_URL_TTL=15m
WORK_ATTACHMENT_MAX_UPLOAD_SIZE=10MB
WORK_ATTACHMENT_MAX_REQUEST_SIZE=11MB
WORK_ATTACHMENT_MAX_PER_TASK=20

# --- Identity JWT (optional; auto-generated in dev if empty) ---
# AGRICORE_JWT_PRIVATE_KEY_PATH=
# AGRICORE_JWT_PUBLIC_KEY_PATH=
JWT_ISSUER=https://agricore.local/identity
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL_SECONDS=604800

# --- Service ports ---
GATEWAY_PORT=8080
IDENTITY_PORT=8081
FARM_PORT=8082
CROP_CATALOG_PORT=8083
CROP_CYCLE_PORT=8084
WORK_PORT=8085
INVENTORY_PORT=8086
HARVEST_PORT=8087
TRACEABILITY_PORT=8092
NOTIFICATION_PORT=8089
IOT_PORT=8090
SALES_PORT=8091
ASSISTANT_PORT=8093
CONSOLE_PORT=3000
AGRICORE_WEB_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# --- Assistant provider (disabled safely until explicitly configured) ---
ASSISTANT_PROVIDER=none
ASSISTANT_PROVIDER_MODEL=
ASSISTANT_PROVIDER_BASE_URL=
# ASSISTANT_PROVIDER_API_KEY=  # Set only in local .env or a secret manager; never commit it.
ASSISTANT_TOOLS_ENABLED=true

# --- Observability ---
OBSERVABILITY_BIND=127.0.0.1
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=agricore_grafana_dev_change_me
TEMPO_OTLP_GRPC_PORT=4317
TEMPO_OTLP_HTTP_PORT=4318
TEMPO_HTTP_PORT=3200
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILES=3
MANAGEMENT_OTLP_TRACING_ENDPOINT=http://localhost:4318/v1/traces
COMPOSE_MANAGEMENT_OTLP_TRACING_ENDPOINT=http://tempo:4318/v1/traces
MANAGEMENT_TRACING_SAMPLING_PROBABILITY=1.0
LOGGING_STRUCTURED_FORMAT_CONSOLE=ecs
LOGGING_STRUCTURED_ECS_SERVICE_ENVIRONMENT=local
